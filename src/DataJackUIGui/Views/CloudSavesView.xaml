<UserControl
    x:Class="DataJackUIGui.Views.CloudSavesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:DataJackUIGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DataJackUIGui.ViewModels"
    xmlns:svc="clr-namespace:DataJackUIGui.Services"
    d:DataContext="{d:DesignInstance Type=vm:CloudSavesViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="Root" Margin="14,14,16,12">
        <Grid.RowDefinitions>
            <!-- Header & Action Buttons -->
            <RowDefinition Height="Auto" />
            <!-- Cloud Provider Strip / Configuration -->
            <RowDefinition Height="Auto" />
            <!-- Master-Detail Body -->
            <RowDefinition Height="*" />
            <!-- Status Bar / Progress Indicator -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Header (Title + Compact Actions) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="22"
                        Foreground="#38bdf8"
                        Symbol="Cloud24" />
                    <TextBlock
                        FontSize="20"
                        FontWeight="Bold"
                        Text="{x:Static res:Strings.CloudSaves_Title}" />
                </StackPanel>
                <TextBlock
                    Margin="32,2,0,0"
                    FontSize="12"
                    Foreground="#9ca3af"
                    Text="{x:Static res:Strings.CloudSaves_Subtitle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Compact Action buttons in header (Area 2) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button
                    Margin="0,0,6,0"
                    Padding="10,5"
                    FontSize="12"
                    Command="{Binding ScanGamesCommand}"
                    Content="{x:Static res:Strings.CloudSaves_Scan}"
                    ToolTip="{x:Static res:Strings.CloudSaves_ScanTooltip}"
                    Icon="{ui:SymbolIcon ArrowSync24}" />
                <ui:Button
                    Margin="0,0,6,0"
                    Padding="10,5"
                    FontSize="12"
                    Command="{Binding BackupAllCommand}"
                    Content="{x:Static res:Strings.CloudSaves_BackupAll}"
                    ToolTip="{x:Static res:Strings.CloudSaves_BackupAllTooltip}"
                    Icon="{ui:SymbolIcon Save24}" />
                <ui:Button
                    Margin="0,0,6,0"
                    Padding="12,5"
                    FontSize="12"
                    Appearance="Primary"
                    Command="{Binding SyncToCloudCommand}"
                    Content="{x:Static res:Strings.CloudSaves_SyncCloud}"
                    ToolTip="{x:Static res:Strings.CloudSaves_SyncCloudTooltip}"
                    Icon="{ui:SymbolIcon Cloud24}" />
                <ui:Button
                    Padding="10,5"
                    FontSize="12"
                    Command="{Binding SyncFromCloudCommand}"
                    Content="{x:Static res:Strings.CloudSaves_RestoreCloud}"
                    ToolTip="{x:Static res:Strings.CloudSaves_RestoreCloudTooltip}"
                    Icon="{ui:SymbolIcon ArrowDownload24}" />
            </StackPanel>
        </Grid>

        <!-- 1. Cloud Provider Strip / Configuration (Area 3) -->
        <Border
            Grid.Row="1"
            Margin="0,12,0,12"
            Padding="12,8"
            Background="#0DFFFFFF"
            BorderBrush="#1AFFFFFF"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" MinWidth="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Provider Label -->
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    FontWeight="SemiBold"
                    FontSize="13"
                    VerticalAlignment="Center"
                    Text="{x:Static res:Strings.CloudSaves_Provider}" />

                <!-- Provider Selector -->
                <ComboBox
                    Grid.Column="1"
                    MinHeight="35"
                    Padding="12,6"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    ItemsSource="{Binding AvailableProviders}"
                    SelectedItem="{Binding SelectedProvider, Mode=TwoWay}" />

                <!-- Compact Auto-Sync Checkbox (Area 3) -->
                <CheckBox
                    Grid.Column="2"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    IsChecked="{Binding AutoSync, Mode=TwoWay}"
                    Content="{x:Static res:Strings.CloudSaves_AutoSync}"
                    ToolTip="{x:Static res:Strings.CloudSaves_AutoSyncTooltip}" />

                <!-- Provider Details & OAuth Flow (Area 3) -->
                <StackPanel Grid.Column="3" Margin="16,0,0,0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- OneDrive OAuth details -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsOneDriveProvider, Converter={StaticResource BoolToVis}}">
                        <!-- Connected State -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsOneDriveConnected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="● " Foreground="#22c55e" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#38bdf8" Text="{Binding OneDriveStatus}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            <ui:Button
                                Margin="10,0,0,0"
                                Padding="8,3"
                                FontSize="11"
                                Appearance="Secondary"
                                Command="{Binding DisconnectOneDriveCommand}"
                                Content="{x:Static res:Strings.CloudSaves_Disconnect}" />
                        </StackPanel>

                        <!-- Not Connected State -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsOneDriveConnected, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#9ca3af" Text="{Binding OneDriveStatus}" Margin="0,0,10,0" />
                            <ui:Button
                                Padding="10,4"
                                FontSize="11.5"
                                Appearance="Primary"
                                Command="{Binding ConnectOneDriveCommand}"
                                Content="{x:Static res:Strings.CloudSaves_Connect}"
                                Icon="{ui:SymbolIcon Cloud24}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Google Drive OAuth details -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsGoogleDriveProvider, Converter={StaticResource BoolToVis}}">
                        <!-- Connected State -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsGoogleDriveConnected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="● " Foreground="#22c55e" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#34d399" Text="{Binding GoogleDriveStatus}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            <ui:Button
                                Margin="10,0,0,0"
                                Padding="8,3"
                                FontSize="11"
                                Appearance="Secondary"
                                Command="{Binding DisconnectGoogleDriveCommand}"
                                Content="{x:Static res:Strings.CloudSaves_Disconnect}" />
                        </StackPanel>

                        <!-- Not Connected State -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsGoogleDriveConnected, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#9ca3af" Text="{Binding GoogleDriveStatus}" Margin="0,0,10,0" />
                            <ui:Button
                                Padding="10,4"
                                FontSize="11.5"
                                Appearance="Primary"
                                Command="{Binding ConnectGoogleDriveCommand}"
                                Content="{x:Static res:Strings.CloudSaves_Connect}"
                                Icon="{ui:SymbolIcon Cloud24}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Rclone details -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsRcloneProvider, Converter={StaticResource BoolToVis}}">
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#9ca3af" Text="Remote: " />
                        <ui:TextBox
                            Width="150"
                            Height="32"
                            Margin="0,0,8,0"
                            FontSize="12"
                            Text="{Binding RcloneRemote, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <ui:Button
                            Padding="8,4"
                            FontSize="11.5"
                            Command="{Binding ConfigureRcloneCommand}"
                            Content="{x:Static res:Strings.CloudSaves_ConfigureRclone}"
                            Icon="{ui:SymbolIcon Wrench24}" />
                        <ui:Button
                            Margin="6,0,0,0"
                            Padding="8,4"
                            FontSize="11.5"
                            Command="{Binding OpenRcloneWebsiteCommand}"
                            ToolTip="Download Rclone from official site"
                            Icon="{ui:SymbolIcon Globe24}" />
                    </StackPanel>

                    <!-- Local Path details -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsLocalProvider, Converter={StaticResource BoolToVis}}">
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#9ca3af" Text="Folder: " Margin="0,0,6,0" />
                        <ui:TextBox
                            Width="260"
                            Height="32"
                            Margin="0,0,6,0"
                            FontSize="12"
                            PlaceholderText="Default (%APPDATA%\DataJackUI\save_backups)"
                            ToolTip="{Binding EffectiveLocalBackupPath}"
                            Text="{Binding LocalBackupPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <ui:Button
                            Padding="8,4"
                            FontSize="11.5"
                            Command="{Binding BrowseLocalBackupPathCommand}"
                            ToolTip="Select custom backup folder"
                            Content="Browse…"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                        <ui:Button
                            Margin="6,0,0,0"
                            Padding="8,4"
                            FontSize="11.5"
                            Command="{Binding OpenLocalBackupFolderCommand}"
                            ToolTip="Open backup folder in Explorer"
                            Icon="{ui:SymbolIcon Open24}" />
                        <ui:Button
                            Margin="6,0,0,0"
                            Padding="8,4"
                            FontSize="11.5"
                            Command="{Binding ResetLocalBackupPathCommand}"
                            ToolTip="Reset to default folder"
                            Visibility="{Binding HasCustomLocalBackupPath, Converter={StaticResource BoolToVis}}"
                            Icon="{ui:SymbolIcon Dismiss24}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Unified Game Saves & Snapshots (Mixed into single layout) -->
        <Border
            Grid.Row="2"
            Background="#08FFFFFF"
            BorderBrush="#18FFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Search & Stats Bar -->
                    <RowDefinition Height="Auto" />
                    <!-- Games Cards List -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search Input Header -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox
                        Grid.Column="0"
                        Height="34"
                        Icon="{ui:SymbolIcon Search24}"
                        PlaceholderText="{x:Static res:Strings.Common_SearchPlaceholder}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0,4,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#64748b"
                        Text="{Binding FilteredGames.Count, StringFormat='{}{0} game(s)'}" />
                </Grid>

                <!-- Loading State -->
                <StackPanel
                    Grid.Row="1"
                    Margin="0,40,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9ca3af" Text="{x:Static res:Strings.Common_Loading}" />
                </StackPanel>

                <!-- Empty State (No Games Found) -->
                <Border
                    Grid.Row="1"
                    Margin="0,30,0,0"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="#06FFFFFF"
                    BorderBrush="#10FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasFilteredGames, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon
                            Symbol="Folder24"
                            FontSize="32"
                            Foreground="#475569"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Margin="0,10,0,0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#94a3b8"
                            HorizontalAlignment="Center"
                            Text="No game save directories detected." />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11.5"
                            Foreground="#64748b"
                            HorizontalAlignment="Center"
                            Text="Click 'Scan' above or start a game to register save folders." />
                    </StackPanel>
                </Border>

                <!-- Unified Game Cards List -->
                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding HasFilteredGames, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding FilteredGames}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CloudGameItemViewModel}">
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="12,10"
                                    Background="#0AFFFFFF"
                                    BorderBrush="#18FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <!-- Card Header (Cover + Info + Actions) -->
                                            <RowDefinition Height="Auto" />
                                            <!-- Snapshots Drawer (Expands inline) -->
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Card Header -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <!-- Cover image (2.14:1 ratio) -->
                                                <ColumnDefinition Width="124" />
                                                <!-- Game metadata & path -->
                                                <ColumnDefinition Width="*" />
                                                <!-- Actions -->
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Cover banner -->
                                            <Border
                                                Grid.Column="0"
                                                Width="116"
                                                Height="54"
                                                CornerRadius="6"
                                                ClipToBounds="True"
                                                Background="#15FFFFFF"
                                                VerticalAlignment="Center">
                                                <Grid>
                                                    <ui:SymbolIcon
                                                        Symbol="Games24"
                                                        FontSize="22"
                                                        Foreground="#475569"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                                    <Image
                                                        Source="{Binding CoverPath, Converter={StaticResource ImagePathToSource}}"
                                                        Stretch="UniformToFill"
                                                        RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Grid>
                                            </Border>

                                            <!-- Details -->
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontWeight="Bold"
                                                        FontSize="14.5"
                                                        Foreground="#f8fafc"
                                                        Text="{Binding GameName}"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,10,2" />
                                                    <Border
                                                        Margin="0,0,6,2"
                                                        Padding="6,1.5"
                                                        CornerRadius="4"
                                                        Background="#1E38bdf8"
                                                        BorderBrush="#3038bdf8"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="10.5"
                                                            FontWeight="SemiBold"
                                                            Foreground="#38bdf8"
                                                            Text="{Binding AppId, StringFormat='App {0}'}" />
                                                    </Border>
                                                    <Border
                                                        Margin="0,0,6,2"
                                                        Padding="6,1.5"
                                                        CornerRadius="4"
                                                        Background="#1E6366f1"
                                                        BorderBrush="#306366f1"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="10.5"
                                                            FontWeight="SemiBold"
                                                            Foreground="#818cf8"
                                                            Text="{Binding LocationDisplay}" />
                                                    </Border>
                                                    <Border
                                                        Margin="0,0,6,2"
                                                        Padding="6,1.5"
                                                        CornerRadius="4"
                                                        Background="#2210b981"
                                                        BorderBrush="#3010b981"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="10.5"
                                                            FontWeight="SemiBold"
                                                            Foreground="#34d399">
                                                            <Run Text="{Binding SnapshotCount, Mode=OneWay}" />
                                                            <Run Text="saves" />
                                                        </TextBlock>
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Save Path -->
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    FontSize="11.5"
                                                    Foreground="#94a3b8"
                                                    Text="{Binding SavePath}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding SavePath}" />

                                                <!-- Stats -->
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock FontSize="11" Foreground="#64748b" Text="Size: " />
                                                    <TextBlock FontSize="11" Foreground="#cbd5e1" FontWeight="Medium" Text="{Binding FormattedSize}" />
                                                    <TextBlock FontSize="11" Foreground="#64748b" Text="  •  Files: " Margin="8,0,0,0" />
                                                    <TextBlock FontSize="11" Foreground="#cbd5e1" FontWeight="Medium" Text="{Binding FileCount}" />
                                                    <TextBlock FontSize="11" Foreground="#64748b" Text="  •  Modified: " Margin="8,0,0,0" Visibility="{Binding LastModified, Converter={StaticResource NullToCollapsed}}" />
                                                    <TextBlock FontSize="11" Foreground="#94a3b8" Text="{Binding LastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Visibility="{Binding LastModified, Converter={StaticResource NullToCollapsed}}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Backup Now -->
                                                <ui:Button
                                                    Margin="0,0,6,0"
                                                    Padding="12,5"
                                                    FontSize="12"
                                                    Appearance="Primary"
                                                    Command="{Binding DataContext.BackupGameCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    Content="{x:Static res:Strings.CloudSaves_BackupNow}"
                                                    ToolTip="Create backup snapshot for this game"
                                                    Icon="{ui:SymbolIcon Save24}" />

                                                <!-- Open Save Folder -->
                                                <ui:Button
                                                    Margin="0,0,4,0"
                                                    Padding="7,5"
                                                    FontSize="11.5"
                                                    Command="{Binding DataContext.OpenGameSaveFolderCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Open save folder in Explorer"
                                                    Icon="{ui:SymbolIcon Folder24}" />

                                                <!-- Custom Save Folder -->
                                                <ui:Button
                                                    Margin="0,0,4,0"
                                                    Padding="7,5"
                                                    FontSize="11.5"
                                                    Command="{Binding DataContext.BrowseGameCustomSaveLocationCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Change custom save location"
                                                    Icon="{ui:SymbolIcon Edit24}" />

                                                <!-- Open Snapshots Folder -->
                                                <ui:Button
                                                    Margin="0,0,6,0"
                                                    Padding="7,5"
                                                    FontSize="11.5"
                                                    Command="{Binding DataContext.OpenGameSnapshotsFolderCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Open snapshots folder in Explorer"
                                                    Icon="{ui:SymbolIcon FolderOpen24}" />

                                                <!-- Snapshots Expander Button -->
                                                <ui:Button
                                                    Padding="10,5"
                                                    FontSize="11.5"
                                                    Command="{Binding DataContext.ToggleGameExpandedCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="History24" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                        <TextBlock VerticalAlignment="Center" Text="Snapshots (" />
                                                        <TextBlock VerticalAlignment="Center" Text="{Binding SnapshotCount, Mode=OneWay}" />
                                                        <TextBlock VerticalAlignment="Center" Text=")" />
                                                        <ui:SymbolIcon
                                                            Symbol="ChevronUp24"
                                                            FontSize="12"
                                                            Margin="5,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                                                        <ui:SymbolIcon
                                                            Symbol="ChevronDown24"
                                                            FontSize="12"
                                                            Margin="5,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsExpanded, Converter={StaticResource InverseBoolToVis}}" />
                                                    </StackPanel>
                                                </ui:Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Snapshots Drawer (Expands inline inside the card) -->
                                        <StackPanel
                                            Grid.Row="1"
                                            Margin="0,10,0,0"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <!-- Divider -->
                                            <Border Height="1" Background="#14FFFFFF" Margin="0,0,0,8" />

                                            <!-- 0 Snapshots Placeholder -->
                                            <Border
                                                Padding="12,8"
                                                Background="#06FFFFFF"
                                                BorderBrush="#10FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Visibility="{Binding HasBackups, Converter={StaticResource InverseBoolToVis}}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Info24" FontSize="15" Foreground="#64748b" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock
                                                        FontSize="11.5"
                                                        Foreground="#94a3b8"
                                                        VerticalAlignment="Center"
                                                        Text="No snapshots yet for this game. Click 'Backup Now' above to create a restore point." />
                                                </StackPanel>
                                            </Border>

                                            <!-- Snapshots List -->
                                            <ItemsControl
                                                ItemsSource="{Binding Snapshots}"
                                                Visibility="{Binding HasBackups, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type svc:SaveBackupSnapshot}">
                                                        <Border
                                                            Margin="0,0,0,5"
                                                            Padding="10,6"
                                                            Background="#07FFFFFF"
                                                            BorderBrush="#12FFFFFF"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Snapshot info -->
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock
                                                                            FontWeight="SemiBold"
                                                                            FontSize="12"
                                                                            Foreground="#f1f5f9"
                                                                            Text="{Binding FormattedDate}" />

                                                                        <!-- Badge: Safety vs Manual -->
                                                                        <Border
                                                                            Margin="8,0,0,0"
                                                                            Padding="5,1"
                                                                            CornerRadius="4"
                                                                            Background="#25f59e0b"
                                                                            Visibility="{Binding IsSafetyBackup, Converter={StaticResource BoolToVis}}">
                                                                            <TextBlock
                                                                                FontSize="9"
                                                                                FontWeight="SemiBold"
                                                                                Foreground="#fbbf24"
                                                                                Text="Safety Pre-Restore" />
                                                                        </Border>

                                                                        <Border
                                                                            Margin="8,0,0,0"
                                                                            Padding="5,1"
                                                                            CornerRadius="4"
                                                                            Background="#2506b6d4"
                                                                            Visibility="{Binding IsSafetyBackup, Converter={StaticResource InverseBoolToVis}}">
                                                                            <TextBlock
                                                                                FontSize="9"
                                                                                FontWeight="SemiBold"
                                                                                Foreground="#22d3ee"
                                                                                Text="Manual Backup" />
                                                                        </Border>
                                                                    </StackPanel>

                                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                        <TextBlock FontSize="10.5" Foreground="#94a3b8" Text="{Binding SnapshotId}" />
                                                                        <TextBlock FontSize="10.5" Foreground="#64748b" Text="  •  " />
                                                                        <TextBlock FontSize="10.5" Foreground="#cbd5e1" Text="{Binding FormattedSize}" />
                                                                        <TextBlock FontSize="10.5" Foreground="#64748b" Text=" (" />
                                                                        <TextBlock FontSize="10.5" Foreground="#cbd5e1" Text="{Binding FileCount, StringFormat='{}{0} files'}" />
                                                                        <TextBlock FontSize="10.5" Foreground="#64748b" Text=")" />
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <!-- Action buttons: Restore / Delete -->
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <ui:Button
                                                                        Padding="10,3"
                                                                        FontSize="11"
                                                                        Appearance="Secondary"
                                                                        Command="{Binding DataContext.RestoreGameSnapshotCommand, ElementName=Root}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="{x:Static res:Strings.CloudSaves_Restore}"
                                                                        Icon="{ui:SymbolIcon ArrowClockwise24}" />
                                                                    <ui:Button
                                                                        Margin="6,0,0,0"
                                                                        Padding="6,3"
                                                                        FontSize="11"
                                                                        Foreground="#f87171"
                                                                        Command="{Binding DataContext.DeleteGameSnapshotCommand, ElementName=Root}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Delete Snapshot"
                                                                        Icon="{ui:SymbolIcon Delete24}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
        <!-- 3. Status Bar / Progress Indicator -->
        <Border
            Grid.Row="3"
            Margin="0,8,0,0"
            Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    FontSize="12"
                    Foreground="#94a3b8"
                    VerticalAlignment="Center"
                    Text="{Binding StatusMessage}" />

                <ProgressBar
                    Grid.Column="1"
                    Width="140"
                    Height="4"
                    IsIndeterminate="True"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
