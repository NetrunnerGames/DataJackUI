<UserControl
    x:Class="DataJackUIGui.Views.CloudSavesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:DataJackUIGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DataJackUIGui.ViewModels"
    xmlns:svc="clr-namespace:DataJackUIGui.Services"
    d:DataContext="{d:DesignInstance Type=vm:CloudSavesViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="Root" Margin="12,16,16,12">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Cloud Provider Setting Bar -->
            <RowDefinition Height="Auto" />
            <!-- Master-Detail Body -->
            <RowDefinition Height="*" />
            <!-- Status Bar / Progress -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="22"
                        Foreground="#38bdf8"
                        Symbol="Cloud24" />
                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Text="{x:Static res:Strings.CloudSaves_Title}" />
                </StackPanel>
                <TextBlock
                    Margin="32,2,0,0"
                    FontSize="12.5"
                    Foreground="#9ca3af"
                    Text="{x:Static res:Strings.CloudSaves_Subtitle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Action buttons in header -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding ScanGamesCommand}"
                    Content="{x:Static res:Strings.CloudSaves_Scan}"
                    Icon="{ui:SymbolIcon ArrowSync24}" />
                <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding BackupAllCommand}"
                    Content="{x:Static res:Strings.CloudSaves_BackupAll}"
                    Icon="{ui:SymbolIcon Save24}" />
                <ui:Button
                    Margin="0,0,8,0"
                    Appearance="Primary"
                    Command="{Binding SyncToCloudCommand}"
                    Content="{x:Static res:Strings.CloudSaves_SyncCloud}"
                    Icon="{ui:SymbolIcon Cloud24}" />
                <ui:Button
                    Command="{Binding SyncFromCloudCommand}"
                    Content="{x:Static res:Strings.CloudSaves_RestoreCloud}"
                    Icon="{ui:SymbolIcon ArrowDownload24}" />
            </StackPanel>
        </Grid>

        <!-- 1. Cloud Provider Strip / Configuration -->
        <Border
            Grid.Row="1"
            Margin="0,14,0,14"
            Padding="14,10"
            Background="#0DFFFFFF"
            BorderBrush="#1FFFFFFF"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Provider Label -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock
                        FontWeight="SemiBold"
                        FontSize="13"
                        VerticalAlignment="Center"
                        Text="{x:Static res:Strings.CloudSaves_Provider}" />
                </StackPanel>

                <!-- Provider Selector -->
                <ComboBox
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding AvailableProviders}"
                    SelectedItem="{Binding SelectedProvider, Mode=TwoWay}" />

                <!-- Auto-Sync Checkbox -->
                <CheckBox
                    Grid.Column="2"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding AutoSync, Mode=TwoWay}"
                    Content="{x:Static res:Strings.CloudSaves_AutoSync}" />

                <!-- Provider Info / Quick Settings -->
                <StackPanel Grid.Column="3" Margin="20,0,0,0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- OneDrive details -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsOneDriveProvider, Converter={StaticResource BoolToVis}}">
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#9ca3af" Text="OneDrive: " />
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#38bdf8" Text="{Binding OneDriveStatus}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                    </StackPanel>

                    <!-- Google Drive details -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsGoogleDriveProvider, Converter={StaticResource BoolToVis}}">
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#9ca3af" Text="Google Drive: " />
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#34d399" Text="{Binding GoogleDriveStatus}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                    </StackPanel>

                    <!-- Rclone details -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsRcloneProvider, Converter={StaticResource BoolToVis}}">
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#9ca3af" Text="Remote: " />
                        <ui:TextBox
                            Width="180"
                            Margin="0,0,8,0"
                            FontSize="12"
                            Text="{Binding RcloneRemote, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <ui:Button
                            Padding="8,4"
                            FontSize="11.5"
                            Command="{Binding ConfigureRcloneCommand}"
                            Content="{x:Static res:Strings.CloudSaves_ConfigureRclone}"
                            Icon="{ui:SymbolIcon Wrench24}" />
                        <ui:Button
                            Margin="6,0,0,0"
                            Padding="8,4"
                            FontSize="11.5"
                            Command="{Binding OpenRcloneWebsiteCommand}"
                            ToolTip="Download Rclone from official site"
                            Icon="{ui:SymbolIcon Globe24}" />
                    </StackPanel>

                    <!-- Local Path details -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsLocalProvider, Converter={StaticResource BoolToVis}}">
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#9ca3af" Text="Folder: " />
                        <ui:TextBox
                            Width="220"
                            Margin="0,0,8,0"
                            FontSize="12"
                            Text="{Binding LocalBackupPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <ui:Button
                            Padding="8,4"
                            FontSize="11.5"
                            Command="{Binding BrowseLocalBackupPathCommand}"
                            Content="Browse…"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Master-Detail Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Game List Panel -->
                <ColumnDefinition Width="360" MinWidth="260" MaxWidth="500" />
                <ColumnDefinition Width="12" />
                <!-- Selected Game & Snapshots Detail Panel -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Search & Games List -->
            <Border
                Grid.Column="0"
                Background="#0AFFFFFF"
                BorderBrush="#1FFFFFFF"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search Input -->
                    <ui:TextBox
                        Grid.Row="0"
                        Margin="0,0,0,10"
                        Icon="{ui:SymbolIcon Search24}"
                        PlaceholderText="{x:Static res:Strings.Common_SearchPlaceholder}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Games List -->
                    <ListBox
                        Grid.Row="1"
                        ItemsSource="{Binding FilteredGames}"
                        SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border
                                                x:Name="CardBorder"
                                                Padding="8"
                                                Background="#08FFFFFF"
                                                BorderBrush="#15FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Cursor="Hand">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="#15FFFFFF" />
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#4038bdf8" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="#2006b6d4" />
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#06b6d4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CloudGameItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Cover thumbnail -->
                                    <Border
                                        Grid.Column="0"
                                        Width="54"
                                        Height="36"
                                        CornerRadius="4"
                                        ClipToBounds="True"
                                        Background="#15FFFFFF">
                                        <Grid>
                                            <ui:SymbolIcon
                                                Symbol="Games24"
                                                FontSize="18"
                                                Foreground="#475569"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                            <Image
                                                Source="{Binding CoverPath, Converter={StaticResource ImagePathToSource}}"
                                                Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>

                                    <!-- Game Details -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                FontWeight="SemiBold"
                                                FontSize="13"
                                                Text="{Binding GameName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <!-- Snapshot count badge -->
                                            <Border
                                                Grid.Column="1"
                                                Margin="4,0,0,0"
                                                Padding="5,1"
                                                CornerRadius="4"
                                                Background="#2210b981"
                                                Visibility="{Binding HasBackups, Converter={StaticResource BoolToVis}}">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="#34d399">
                                                    <Run Text="{Binding SnapshotCount, Mode=OneWay}" />
                                                    <Run Text="saves" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#94a3b8"
                                                Text="{Binding LocationDisplay}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#64748b"
                                                Text=" · " />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#94a3b8"
                                                Text="{Binding FormattedSize}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right Panel: Selected Game Detail & Snapshot History -->
            <Border
                Grid.Column="2"
                Background="#0AFFFFFF"
                BorderBrush="#1FFFFFFF"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16">
                <!-- When game is selected -->
                <Grid Visibility="{Binding SelectedGame, Converter={StaticResource NullToCollapsed}}">
                    <Grid.RowDefinitions>
                        <!-- Game Header Card -->
                        <RowDefinition Height="Auto" />
                        <!-- Snapshots List Section -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Game Overview Header Card -->
                    <Border
                        Grid.Row="0"
                        Padding="14"
                        Background="#0DFFFFFF"
                        BorderBrush="#1FFFFFFF"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Big Cover -->
                            <Border
                                Grid.Column="0"
                                Width="94"
                                Height="60"
                                CornerRadius="6"
                                ClipToBounds="True"
                                Background="#15FFFFFF">
                                <Grid>
                                    <ui:SymbolIcon
                                        Symbol="Games24"
                                        FontSize="24"
                                        Foreground="#475569"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                    <Image
                                        Source="{Binding SelectedGame.CoverPath, Converter={StaticResource ImagePathToSource}}"
                                        Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <!-- Game Info & Live Path -->
                            <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Text="{Binding SelectedGame.GameName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Border
                                        Margin="8,0,0,0"
                                        Padding="5,1"
                                        CornerRadius="4"
                                        Background="#2038bdf8"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            Foreground="#38bdf8"
                                            Text="{Binding SelectedGame.AppId, StringFormat='App {0}'}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="11.5"
                                    Foreground="#9ca3af"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding SelectedGame.SavePath}">
                                    <Run Text="Save Path: " />
                                    <Run Text="{Binding SelectedGame.SavePath, Mode=OneWay}" Foreground="#cbd5e1" />
                                </TextBlock>

                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock FontSize="11" Foreground="#64748b" Text="Location: " />
                                    <TextBlock FontSize="11" Foreground="#a5b4fc" Text="{Binding SelectedGame.LocationDisplay, Mode=OneWay}" />
                                    <TextBlock FontSize="11" Foreground="#64748b" Text="  •  Size: " />
                                    <TextBlock FontSize="11" Foreground="#e2e8f0" Text="{Binding SelectedGame.FormattedSize, Mode=OneWay}" />
                                    <TextBlock FontSize="11" Foreground="#64748b" Text=" (" />
                                    <TextBlock FontSize="11" Foreground="#e2e8f0" Text="{Binding SelectedGame.FileCount, Mode=OneWay, StringFormat='{}{0} files'}" />
                                    <TextBlock FontSize="11" Foreground="#64748b" Text=")" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Actions for this game -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <ui:Button
                                    MinWidth="130"
                                    Appearance="Primary"
                                    Command="{Binding BackupSelectedCommand}"
                                    Content="{x:Static res:Strings.CloudSaves_BackupNow}"
                                    Icon="{ui:SymbolIcon Save24}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <ui:Button
                                        Padding="6,4"
                                        FontSize="11.5"
                                        Command="{Binding OpenLiveSaveFolderCommand}"
                                        ToolTip="Open live game save folder in File Explorer"
                                        Icon="{ui:SymbolIcon FolderOpen24}" />
                                    <ui:Button
                                        Margin="4,0,0,0"
                                        Padding="6,4"
                                        FontSize="11.5"
                                        Command="{Binding BrowseCustomSaveLocationCommand}"
                                        ToolTip="Set custom save directory override"
                                        Icon="{ui:SymbolIcon Wrench24}" />
                                    <ui:Button
                                        Margin="4,0,0,0"
                                        Padding="6,4"
                                        FontSize="11.5"
                                        Command="{Binding ResetCustomSaveLocationCommand}"
                                        ToolTip="Reset to auto-detected save path"
                                        Icon="{ui:SymbolIcon ArrowClockwise24}" />
                                    <ui:Button
                                        Margin="4,0,0,0"
                                        Padding="6,4"
                                        FontSize="11.5"
                                        Command="{Binding OpenSnapshotsFolderCommand}"
                                        ToolTip="Open snapshots folder in File Explorer"
                                        Icon="{ui:SymbolIcon DocumentFolder24}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Snapshots History List -->
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="{x:Static res:Strings.CloudSaves_Snapshots}" />
                            <TextBlock
                                Margin="6,0,0,0"
                                FontSize="13"
                                VerticalAlignment="Center"
                                Foreground="#94a3b8"
                                Text="{Binding Snapshots.Count, StringFormat='({0})'}" />
                        </StackPanel>

                        <!-- Empty Snapshots message -->
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,30,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Foreground="#64748b"
                            FontSize="13"
                            Text="{x:Static res:Strings.CloudSaves_NoSnapshots}"
                            Visibility="{Binding Snapshots.Count, Converter={StaticResource InverseBoolToVis}}" />

                        <!-- Snapshots Collection -->
                        <ListBox
                            Grid.Row="1"
                            ItemsSource="{Binding Snapshots}"
                            Background="Transparent"
                            BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border
                                                    Padding="12,10"
                                                    Background="#08FFFFFF"
                                                    BorderBrush="#14FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type svc:SaveBackupSnapshot}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Snapshot info -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    FontSize="13.5"
                                                    Text="{Binding FormattedDate}" />

                                                <!-- Badge: Safety vs User Snapshot -->
                                                <Border
                                                    Margin="10,0,0,0"
                                                    Padding="6,1"
                                                    CornerRadius="4"
                                                    Background="#25f59e0b"
                                                    Visibility="{Binding IsSafetyBackup, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="#fbbf24"
                                                        Text="Safety Pre-Restore" />
                                                </Border>

                                                <Border
                                                    Margin="10,0,0,0"
                                                    Padding="6,1"
                                                    CornerRadius="4"
                                                    Background="#2506b6d4"
                                                    Visibility="{Binding IsSafetyBackup, Converter={StaticResource InverseBoolToVis}}">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="#22d3ee"
                                                        Text="Manual Backup" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock FontSize="11.5" Foreground="#94a3b8" Text="{Binding SnapshotId}" />
                                                <TextBlock FontSize="11.5" Foreground="#64748b" Text="  •  " />
                                                <TextBlock FontSize="11.5" Foreground="#cbd5e1" Text="{Binding FormattedSize}" />
                                                <TextBlock FontSize="11.5" Foreground="#64748b" Text=" (" />
                                                <TextBlock FontSize="11.5" Foreground="#cbd5e1" Text="{Binding FileCount, StringFormat='{}{0} files'}" />
                                                <TextBlock FontSize="11.5" Foreground="#64748b" Text=")" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Action buttons: Restore / Delete -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button
                                                Padding="12,5"
                                                FontSize="12"
                                                Appearance="Secondary"
                                                Command="{Binding DataContext.RestoreSnapshotCommand, ElementName=Root}"
                                                CommandParameter="{Binding}"
                                                Content="{x:Static res:Strings.CloudSaves_Restore}"
                                                Icon="{ui:SymbolIcon ArrowClockwise24}" />
                                            <ui:Button
                                                Margin="6,0,0,0"
                                                Padding="8,5"
                                                FontSize="12"
                                                Foreground="#f87171"
                                                Command="{Binding DataContext.DeleteSnapshotCommand, ElementName=Root}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Delete Snapshot"
                                                Icon="{ui:SymbolIcon Delete24}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Status Bar / Progress Indicator -->
        <Border
            Grid.Row="3"
            Margin="0,8,0,0"
            Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    FontSize="12"
                    Foreground="#94a3b8"
                    VerticalAlignment="Center"
                    Text="{Binding StatusMessage}" />

                <ProgressBar
                    Grid.Column="1"
                    Width="140"
                    Height="4"
                    IsIndeterminate="True"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
