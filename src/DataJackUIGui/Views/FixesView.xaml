<UserControl
    x:Class="DataJackUIGui.Views.FixesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
    xmlns:res="clr-namespace:DataJackUIGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DataJackUIGui.ViewModels"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    d:DataContext="{d:DesignInstance Type=vm:FixesViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Page-size ComboBox item display: shows the localized label while the bound value stays the
             English key (mirrors ManageView; FilterOptionDisplay is a global converter). -->
        <DataTemplate x:Key="FilterOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource FilterOptionDisplay}}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" Margin="8,16,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="22" FontWeight="Bold" Text="{x:Static res:Strings.Fixes_Title}" />
            </StackPanel>
            <ui:Button
                Grid.Column="1"
                VerticalAlignment="Top"
                Command="{Binding RefreshCommand}"
                Content="{x:Static res:Strings.Manage_Refresh}"
                Icon="{ui:SymbolIcon ArrowSync24}" />
        </Grid>

        <!-- Search -->
        <ui:TextBox
            Grid.Row="1"
            Margin="0,14,0,0"
            Icon="{ui:SymbolIcon Search24}"
            PlaceholderText="{x:Static res:Strings.Common_SearchPlaceholder}"
            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Tag filter pills (shown once the listing is loaded and non-empty) -->
        <StackPanel
            Grid.Row="2"
            Margin="0,12,0,0"
            Orientation="Horizontal"
            Visibility="{Binding CanFilter, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Tags}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Margin="0,0,6,6"
                            Command="{Binding DataContext.SelectTagCommand, ElementName=Root}"
                            CommandParameter="{Binding Id}"
                            Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="Pill"
                                        Padding="10,4"
                                        Background="#14a78bfa"
                                        BorderBrush="#40a78bfa"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <TextBlock
                                            x:Name="PillText"
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            Foreground="#a78bfa"
                                            Text="{Binding Name}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- Active: filled accent. -->
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Pill" Property="Background" Value="#a78bfa" />
                                            <Setter TargetName="Pill" Property="BorderBrush" Value="#a78bfa" />
                                            <Setter TargetName="PillText" Property="Foreground" Value="#ffffff" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Pill" Property="Background" Value="#28a78bfa" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Loading -->
        <StackPanel
            Grid.Row="3"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" />
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9ca3af" Text="{x:Static res:Strings.Fixes_Loading}" />
        </StackPanel>

        <!-- Empty -->
        <TextBlock
            Grid.Row="3"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Foreground="#9ca3af"
            Text="{Binding EmptyMessage}"
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

        <!-- Game grid -->
        <vwp:VirtualizingItemsControl
            x:Name="GameScroller"
            Grid.Row="3"
            Margin="0,14,0,0"
            ItemsSource="{Binding Items}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}"
            VirtualizingPanel.CacheLengthUnit="Page"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Standard">
            <vwp:VirtualizingItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="StartAndEndOnly" StretchItems="False" />
                </ItemsPanelTemplate>
            </vwp:VirtualizingItemsControl.ItemsPanel>
            <vwp:VirtualizingItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button
                        Width="248"
                        Height="180"
                        Margin="0,0,12,12"
                        Padding="0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Background="#0DFFFFFF"
                        BorderBrush="#14FFFFFF"
                        BorderThickness="1"
                        Command="{Binding DataContext.OpenGameCommand, ElementName=Root}"
                        CommandParameter="{Binding}"
                        Cursor="Hand">
                        <Button.Tag>
                            <Binding ElementName="Root" Path="DataContext" />
                        </Button.Tag>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.CopyAppIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Common_CopyAppId}"
                                    Icon="{ui:SymbolIcon Copy24}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Common_ShowInFolder}"
                                    Icon="{ui:SymbolIcon FolderOpen24}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                    <StackPanel>
                                        <Border Height="116" Background="#11FFFFFF" ClipToBounds="True" CornerRadius="10,10,0,0">
                                            <Image Source="{Binding Cover, Converter={StaticResource ImagePathToSource}}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Margin="12,8,12,10">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#e5e7eb"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0" FontSize="11.5" FontWeight="Medium" Foreground="#a78bfa" Text="{Binding FixTypeLabel}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </vwp:VirtualizingItemsControl.ItemTemplate>
        </vwp:VirtualizingItemsControl>

        <!-- Pager bar: page numbers centered across the full width, with sort dropdown on the left
             and results-per-page on the right. Shown once game cards are present. -->
        <Grid
            Grid.Row="4"
            Margin="0,12,0,2"
            Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}">

            <!-- Left: sort dropdown (A to Z / Z to A) -->
            <StackPanel
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    Foreground="#9ca3af"
                    Text="{x:Static res:Strings.Manage_Filter_SortBy}" />
                <ComboBox
                    MinWidth="90"
                    ItemTemplate="{StaticResource FilterOptionTemplate}"
                    ItemsSource="{Binding SortOptions}"
                    SelectedItem="{Binding SelectedSort}" />
            </StackPanel>

            <!-- Centered group: ‹ prev | page numbers (fixed-width zone) | › next. -->
            <Grid
                HorizontalAlignment="Center"
                Visibility="{Binding ShowPager, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button
                    Grid.Column="0"
                    Margin="2,0"
                    Padding="8,4"
                    Command="{Binding PrevPageCommand}"
                    Content="‹"
                    FontSize="14"
                    IsEnabled="{Binding CanGoPrev}" />
                <ItemsControl Grid.Column="1" HorizontalAlignment="Center" ItemsSource="{Binding PageNumbers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Ellipsis gap (sentinel 0): non-clickable "…" -->
                                <TextBlock
                                    Margin="6,0"
                                    VerticalAlignment="Center"
                                    Foreground="#6b7280"
                                    Text="…">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Page-number button -->
                                <ui:Button
                                    Margin="2,0"
                                    Padding="8,4"
                                    Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding}"
                                    FontSize="13">
                                    <ui:Button.Style>
                                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                            <Style.Triggers>
                                                <!-- Hide the button for the ellipsis sentinel (0) -->
                                                <DataTrigger Binding="{Binding}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <!-- Highlight the active page -->
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource EqualityMulti}">
                                                            <Binding />
                                                            <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Appearance" Value="Primary" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button
                    Grid.Column="2"
                    Margin="2,0"
                    Padding="8,4"
                    Command="{Binding NextPageCommand}"
                    Content="›"
                    FontSize="14"
                    IsEnabled="{Binding CanGoNext}" />
            </Grid>

            <!-- Right: results-per-page (overlaid at the right edge, doesn't shift the centered pager) -->
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    Foreground="#9ca3af"
                    Text="{x:Static res:Strings.Manage_ResultsPerPage}" />
                <ComboBox
                    MinWidth="72"
                    ItemTemplate="{StaticResource FilterOptionTemplate}"
                    ItemsSource="{Binding PageSizeOptions}"
                    SelectedItem="{Binding SelectedPageSize}" />
            </StackPanel>
        </Grid>

        <!-- ── Detail flyout ─────────────────────────────────────────── -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="5"
            Margin="-8,-16,-16,-8"
            Background="#80000000"
            Cursor="Arrow"
            Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="Transparent" Cursor="Arrow" MouseLeftButtonUp="Scrim_Click" />
            <Border
                Width="420"
                HorizontalAlignment="Right"
                Background="#1c1c22"
                BorderBrush="#22FFFFFF"
                BorderThickness="1,0,0,0"
                Cursor="Arrow">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Banner (Full Fit across drawer width) -->
                    <Grid Grid.Row="0" DataContext="{Binding SelectedGame}">
                        <Border Height="180" Background="#11FFFFFF" ClipToBounds="True">
                            <Image Source="{Binding Cover, Converter={StaticResource ImagePathToSource}}" Stretch="UniformToFill" />
                        </Border>

                        <!-- Close Button floating top-right over banner -->
                        <ui:Button
                            Margin="0,12,12,0"
                            Padding="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#991c1c22"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            Click="Close_Click"
                            CornerRadius="16"
                            Icon="{ui:SymbolIcon Dismiss24}" />
                    </Grid>

                    <!-- Title & App ID -->
                    <StackPanel Grid.Row="1" Margin="18,14,18,0" DataContext="{Binding SelectedGame}">
                        <TextBlock FontSize="16.5" FontWeight="Bold" Foreground="#ffffff" Text="{Binding Name}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,2,0,0" FontSize="11.5" Foreground="#6b7280" Text="{Binding DisplayAppId, StringFormat='App ID: {0}'}" />
                    </StackPanel>

                    <!-- Fixes list -->
                    <ScrollViewer Grid.Row="2" Margin="18,12,18,16" VerticalScrollBarVisibility="Auto" DataContext="{Binding DataContext, ElementName=Root}">
                        <!-- Right margin keeps the scrollbar in its own lane instead of sitting on the rows. -->
                        <StackPanel Margin="0,0,8,0">
                            <!-- Loading fixes -->
                            <StackPanel
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding IsLoadingFixes, Converter={StaticResource BoolToVis}}">
                                <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#9ca3af" Text="{x:Static res:Strings.Common_Loading}" />
                            </StackPanel>

                            <!-- Per-game tag filter (only when this game's fixes span multiple tags) -->
                            <ItemsControl
                                Margin="0,0,0,10"
                                ItemsSource="{Binding FixTags}"
                                Visibility="{Binding HasFixTags, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Margin="0,0,6,6"
                                            Command="{Binding DataContext.SelectFixTagCommand, ElementName=Root}"
                                            CommandParameter="{Binding Id}"
                                            Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                        x:Name="Pill"
                                                        Padding="10,4"
                                                        Background="#14a78bfa"
                                                        BorderBrush="#40a78bfa"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                        <TextBlock x:Name="PillText" FontSize="11" FontWeight="SemiBold" Foreground="#a78bfa" Text="{Binding Name}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Pill" Property="Background" Value="#a78bfa" />
                                                            <Setter TargetName="Pill" Property="BorderBrush" Value="#a78bfa" />
                                                            <Setter TargetName="PillText" Property="Foreground" Value="#ffffff" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Pill" Property="Background" Value="#28a78bfa" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Fix Cards -->
                            <ItemsControl ItemsSource="{Binding Fixes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,10"
                                            Padding="14,12"
                                            Background="#0DFFFFFF"
                                            BorderBrush="#1FFFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <StackPanel>
                                                <!-- Row 1: [Bypass] badge · size -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ItemsControl ItemsSource="{Binding Tags}" VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,6,0" Padding="8,3" Background="#2a2440" BorderBrush="#40a78bfa" BorderThickness="1" CornerRadius="4">
                                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#c4b5fd" Text="{Binding Name}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="12.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="#a78bfa"
                                                        Text="{Binding SizeLabel, StringFormat='•  {0}'}"
                                                        Visibility="{Binding HasSize, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>

                                                <!-- Row 2: Fix button | Revert button -->
                                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                                    <ui:Button
                                                        Margin="0,0,10,0"
                                                        Padding="16,7"
                                                        Appearance="Primary"
                                                        Command="{Binding DataContext.DownloadFixCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"
                                                        Content="{x:Static res:Strings.Fixes_Fix}"
                                                        Icon="{ui:SymbolIcon Wrench24}"
                                                        IsEnabled="{Binding CanDownloadFix}"
                                                        ToolTip="{Binding FixHint}"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        Visibility="{Binding HasFix, Converter={StaticResource BoolToVis}}" />
                                                    <ui:Button
                                                        Margin="0,0,10,0"
                                                        Padding="14,7"
                                                        Command="{Binding DataContext.RevertFixCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"
                                                        Content="{x:Static res:Strings.Fixes_Revert}"
                                                        Icon="{ui:SymbolIcon ArrowClockwise24}"
                                                        Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>

                                                <!-- Progress Bar -->
                                                <ProgressBar
                                                    Height="4"
                                                    Margin="0,8,0,0"
                                                    IsIndeterminate="{Binding FixItem.IsIndeterminate, FallbackValue=False}"
                                                    Maximum="100"
                                                    Value="{Binding FixItem.Percent, Mode=OneWay, FallbackValue=0}"
                                                    Visibility="{Binding FixItem.ShowProgress, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Revert confirmation overlay (in-flyout card, same pattern as ModeView). -->
                    <Grid
                        Background="#99000000"
                        Visibility="{Binding IsConfirmingRevert, Converter={StaticResource BoolToVis}}">
                        <Border
                            MaxWidth="360"
                            Margin="16"
                            Padding="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1c1c22"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel>
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="{Binding ConfirmRevertTitle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontSize="12.5"
                                    Foreground="#9ca3af"
                                    Text="{Binding ConfirmRevertBody}"
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    Margin="0,18,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                                    <ui:Button
                                        Margin="0,0,10,0"
                                        Padding="14,7"
                                        Command="{Binding CancelRevertConfirmCommand}"
                                        Content="{x:Static res:Strings.Fixes_Revert_Cancel}" />
                                    <ui:Button
                                        Padding="14,7"
                                        Appearance="Primary"
                                        Command="{Binding ConfirmRevertCommand}"
                                        Content="{x:Static res:Strings.Fixes_Revert}"
                                        Icon="{ui:SymbolIcon ArrowClockwise24}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
