<ui:FluentWindow
    x:Class="DataJackUIGui.Views.LaunchOverridesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:DataJackUIGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static res:Strings.Launch_AllOverrides}"
    Width="640"
    Height="520"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{x:Static res:Strings.Launch_AllOverrides}" Grid.Row="0" />

        <TextBlock
            Name="Empty"
            Grid.Row="1"
            Margin="16,8,16,16"
            FontSize="12"
            Foreground="#9ca3af"
            Text="{x:Static res:Strings.Launch_AllOverrides_Empty}"
            Visibility="Collapsed" />

        <ScrollViewer
            Grid.Row="1"
            Margin="16,4,4,16"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="Rows" Margin="0,0,12,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,10"
                            Padding="12,10"
                            Background="#0DFFFFFF"
                            BorderBrush="#1FFFFFFF"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock
                                        FontSize="13.5"
                                        FontWeight="SemiBold"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,1,0,6"
                                        FontSize="11"
                                        Foreground="#9ca3af"
                                        Text="{Binding AppId, StringFormat={x:Static res:Strings.Common_AppId}}" />
                                    <ItemsControl ItemsSource="{Binding Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,3,0,0">
                                                    <TextBlock
                                                        FontSize="12.5"
                                                        Text="{Binding Title}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        FontSize="10.5"
                                                        Foreground="#6b7280"
                                                        Text="{Binding Subtitle}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <ui:Button
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Top"
                                    Click="Edit_Click"
                                    Content="{x:Static res:Strings.Launch_Edit}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ui:Button
            Name="RestoreAll"
            Grid.Row="2"
            Margin="16,0,16,16"
            HorizontalAlignment="Right"
            Appearance="Danger"
            Click="RestoreAll_Click"
            Content="{x:Static res:Strings.Launch_RestoreAll}" />
    </Grid>
</ui:FluentWindow>
