<UserControl
    x:Class="DataJackUIGui.Views.FaqView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DataJackUIGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:FaqViewModel}"
    d:DesignHeight="700"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock
                FontSize="24"
                FontWeight="Bold"
                Foreground="White"
                Text="Frequently Asked Questions" />
            <TextBlock
                Margin="0,4,0,0"
                FontSize="13"
                Foreground="#9ca3af"
                Text="Knowledge base, setup walkthroughs, and troubleshooting guides." />
        </StackPanel>

        <!--  Main Content Area with Blurred Skeleton Items & Coming Soon Overlay  -->
        <Grid Grid.Row="1">
            <!--  Blurred Placeholder / Skeleton FAQs  -->
            <ScrollViewer
                IsHitTestVisible="False"
                Opacity="0.38"
                VerticalScrollBarVisibility="Hidden">
                <ScrollViewer.Effect>
                    <BlurEffect Radius="9" />
                </ScrollViewer.Effect>
                <ItemsControl ItemsSource="{Binding PlaceholderItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FaqPlaceholderItem}">
                            <Border
                                Margin="0,0,0,14"
                                Padding="16,14"
                                Background="#14141e"
                                BorderBrush="#252536"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="#e5e7eb"
                                            Text="{Binding Question}" />
                                        <Border
                                            Grid.Column="1"
                                            Padding="8,2"
                                            Background="#1f1f2e"
                                            CornerRadius="4">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#9ca3af"
                                                Text="{Binding Category}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="#6b7280"
                                        LineHeight="18"
                                        Text="{Binding Answer}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!--  "Coming Soon" Floating Glass Badge / Card  -->
            <Border
                Padding="36,28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#EE0e0e17"
                BorderBrush="#3b82f6"
                BorderThickness="1"
                CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="32"
                        Opacity="0.45"
                        ShadowDepth="0"
                        Color="#3b82f6" />
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <Border
                        Width="56"
                        Height="56"
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        Background="#1e293b"
                        BorderBrush="#60a5fa"
                        BorderThickness="1"
                        CornerRadius="28">
                        <ui:SymbolIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="26"
                            Foreground="#60a5fa"
                            Symbol="Clock24" />
                    </Border>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Knowledge Base Coming Soon" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="#9ca3af"
                        Text="Comprehensive step-by-step guides, FAQs, and tutorials are currently being prepared."
                        TextAlignment="Center" />
                    <Border
                        Margin="0,16,0,0"
                        Padding="10,4"
                        HorizontalAlignment="Center"
                        Background="#1e1e2d"
                        BorderBrush="#374151"
                        BorderThickness="1"
                        CornerRadius="6">
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#60a5fa"
                            Text="UNDER PREPARATION" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
