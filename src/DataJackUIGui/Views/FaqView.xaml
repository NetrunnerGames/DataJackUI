<UserControl
    x:Class="DataJackUIGui.Views.FaqView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DataJackUIGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:FaqViewModel}"
    d:DesignHeight="700"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <Grid Margin="16,16,16,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock
                FontSize="22"
                FontWeight="Bold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="Frequently Asked Questions" />
            <TextBlock
                Margin="0,4,0,0"
                FontSize="13"
                Foreground="#9ca3af"
                Text="Knowledge base, setup walkthroughs, and troubleshooting guides." />
        </StackPanel>

        <!--  Main Content Area with Blurred Skeleton Items & Coming Soon Overlay  -->
        <Grid Grid.Row="1">
            <!--  Blurred Placeholder / Skeleton FAQs (matching native App Card styling)  -->
            <ScrollViewer
                IsHitTestVisible="False"
                Opacity="0.32"
                VerticalScrollBarVisibility="Hidden">
                <ScrollViewer.Effect>
                    <BlurEffect Radius="14" RenderingBias="Performance" />
                </ScrollViewer.Effect>
                <ItemsControl ItemsSource="{Binding PlaceholderItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FaqPlaceholderItem}">
                            <Border
                                Margin="0,0,0,12"
                                Padding="18"
                                Background="#0DFFFFFF"
                                BorderBrush="#1FFFFFFF"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            FontSize="14.5"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Question}" />
                                        <Border
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Padding="8,2.5"
                                            Background="#14FFFFFF"
                                            BorderBrush="#20FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#9ca3af"
                                                Text="{Binding Category}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        FontSize="12.5"
                                        Foreground="#6b7280"
                                        LineHeight="19"
                                        Text="{Binding Answer}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!--  "Coming Soon" Floating Card (crisp, pixel-sharp, non-blurred fluent card)  -->
            <Border
                MaxWidth="520"
                Padding="32,28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1e1e24"
                BorderBrush="#38FFFFFF"
                BorderThickness="1"
                CornerRadius="14"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="32"
                        Direction="270"
                        Opacity="0.75"
                        ShadowDepth="8"
                        Color="#000000" />
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <Border
                        Width="52"
                        Height="52"
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        Background="#0DFFFFFF"
                        BorderBrush="#28FFFFFF"
                        BorderThickness="1"
                        CornerRadius="26">
                        <ui:SymbolIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="24"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            Symbol="Clock24" />
                    </Border>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Coming Soon" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="#9ca3af"
                        Text="This section hasn't been fully built yet, we will notify you once it's built fully"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Border
                        Margin="0,18,0,0"
                        Padding="12,4"
                        HorizontalAlignment="Center"
                        Background="#14FFFFFF"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1"
                        CornerRadius="6">
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            Text="UNDER PREPARATION" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
