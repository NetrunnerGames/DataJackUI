<UserControl
    x:Class="DataJackUIGui.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:DataJackUIGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:DataJackUIGui.Views"
    xmlns:vm="clr-namespace:DataJackUIGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Clickable stat tile: the card look, with a hover brighten (same idiom as the recent cards). -->
        <Style x:Key="CardTileButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Padding="16,14" Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#18FFFFFF" />
                                <Setter TargetName="B" Property="BorderBrush" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Clickable status row: transparent, hover brighten. -->
        <Style x:Key="StatusRowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Padding="6,5" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
    <ScrollViewer x:Name="Root" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" Margin="8,16,16,24">

            <!-- Greeting -->
            <TextBlock
                FontSize="22"
                FontWeight="Bold"
                Text="{x:Static res:Strings.Home_Welcome}" />

            <!-- Stat tiles (clickable) -->
            <UniformGrid Margin="0,18,0,0" Columns="2" Rows="1">
                <!-- Games on board → Manage -->
                <Button Margin="0,0,6,0" Command="{Binding OpenManageCommand}" Style="{StaticResource CardTileButton}">
                    <StackPanel>
                        <TextBlock
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="#a78bfa"
                            Text="{Binding GameCount}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="#9ca3af"
                            Text="{x:Static res:Strings.Home_LuasOnBoard}" />
                    </StackPanel>
                </Button>
                <!-- Plugin status → Plugin page (+ inline Install when not installed) -->
                <Button Margin="6,0,0,0" Command="{Binding OpenPluginCommand}" Style="{StaticResource CardTileButton}">
                    <StackPanel>
                        <TextBlock
                            FontSize="12"
                            Foreground="#6b7280"
                            Text="{x:Static res:Strings.Home_PluginStatus}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{Binding PluginStatusColor}"
                            Text="{Binding PluginStatusText}"
                            TextTrimming="CharacterEllipsis" />
                        <ui:Button
                            Margin="0,10,0,0"
                            Padding="10,4"
                            Appearance="Primary"
                            Command="{Binding InstallPluginCommand}"
                            Content="{x:Static res:Strings.Plugin_Btn_Install}"
                            IsEnabled="{Binding NotInstallingPlugin}"
                            Visibility="{Binding ShowPluginInstall, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Status: Steam + account -->
            <Border
                Margin="0,12,0,0"
                Padding="10,19"
                Background="#0DFFFFFF"
                BorderBrush="#14FFFFFF"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <!-- Steam → Settings -->
                    <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource StatusRowButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Margin="0,1,0,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Symbol="Games24">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="#f87171" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SteamFound}" Value="True">
                                                <Setter Property="Foreground" Value="#34d399" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="#d1d5db"
                                Text="{Binding SteamStatus}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Button>

                    <Separator Margin="0,10" Background="#14FFFFFF" />

                    <!-- Account → Settings -->
                    <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource StatusRowButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Margin="0,1,0,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#a78bfa"
                                Symbol="Person24" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="#d1d5db"
                                Text="{Binding AccountStatus}" />
                        </Grid>
                    </Button>

                    <Separator Margin="0,10" Background="#14FFFFFF" />

                    <!-- Active mode → Mode -->
                    <Button Command="{Binding OpenModeCommand}" Style="{StaticResource StatusRowButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Margin="0,1,0,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#a78bfa"
                                Symbol="Options24" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="#d1d5db"
                                Text="{Binding ModeStatus}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>



            <!-- Recently added -->
            <StackPanel Margin="0,22,0,0" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}">
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="{x:Static res:Strings.Home_RecentlyAdded}" />
                <ScrollViewer
                    x:Name="RecentScroller"
                    Margin="0,12,0,0"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    PreviewMouseWheel="RecentStrip_PreviewMouseWheel"
                    Focusable="False">
                    <ItemsControl ItemsSource="{Binding Recent}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Margin="0,0,12,12"
                                Padding="0"
                                Command="{Binding DataContext.OpenGameCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Cursor="Hand"
                                ToolTip="{x:Static res:Strings.Home_ViewDetails}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="Card"
                                            Width="170"
                                            Background="#0DFFFFFF"
                                            BorderBrush="#14FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                            <StackPanel>
                                                <Border
                                                    Height="80"
                                                    Background="#11FFFFFF"
                                                    ClipToBounds="True"
                                                    CornerRadius="10,10,0,0">
                                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock
                                                    Margin="10,8,10,10"
                                                    FontSize="12.5"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="#18FFFFFF" />
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#33FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- Discord Help & Support Area -->
            <Border
                Margin="0,16,0,0"
                Padding="16,14"
                Background="#0DFFFFFF"
                BorderBrush="#14FFFFFF"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Symbol="QuestionCircle24"
                                FontSize="16"
                                Foreground="#a78bfa"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Margin="8,0,0,0"
                                FontSize="13.5"
                                FontWeight="SemiBold"
                                Text="Community &amp; Support"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="12"
                            Foreground="#9ca3af"
                            Text="For queries related to app or help/support related to the app, please contact us on discord."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ui:Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Appearance="Primary"
                        Background="#5865F2"
                        BorderBrush="#4752C4"
                        Cursor="Hand"
                        Padding="14,7"
                        Command="{Binding OpenSupportDiscordCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                <Path
                                    Data="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.865-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037c-1.687.29-3.33.8-4.885 1.515a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.083.083 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.093.252-.19.372-.287a.075.075 0 0 1 .078-.01c3.927 1.793 8.18 1.793 12.061 0a.075.075 0 0 1 .079.009c.12.098.245.195.372.288a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
                                    Fill="White"
                                    Stretch="Uniform" />
                            </Viewbox>
                            <TextBlock
                                Text="Join"
                                FontWeight="SemiBold"
                                FontSize="13"
                                VerticalAlignment="Center"
                                Foreground="White" />
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>


    </Grid>
</UserControl>
