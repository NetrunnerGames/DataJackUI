<UserControl
    x:Class="DataJackUIGui.Views.OnlineFixesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:DataJackUIGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DataJackUIGui.ViewModels"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    d:DataContext="{d:DesignInstance Type=vm:OnlineFixesViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--
            Page-size ComboBox item display: shows the localized label while the bound value stays the
            English key (mirrors ManageView; FilterOptionDisplay is a global converter).
        -->
        <DataTemplate x:Key="FilterOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource FilterOptionDisplay}}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" Margin="8,16,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Text="{x:Static res:Strings.Nav_OnlineFix}" />
            </StackPanel>
            <ui:Button
                Grid.Column="1"
                VerticalAlignment="Top"
                Command="{Binding RefreshCommand}"
                Content="{x:Static res:Strings.Manage_Refresh}"
                Icon="{ui:SymbolIcon ArrowSync24}" />
        </Grid>

        <!--  Search  -->
        <ui:TextBox
            Grid.Row="1"
            Margin="0,14,0,0"
            Icon="{ui:SymbolIcon Search24}"
            PlaceholderText="{x:Static res:Strings.Common_SearchPlaceholder}"
            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />



        <!--  Loading  -->
        <StackPanel
            Grid.Row="3"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <ui:ProgressRing
                Width="20"
                Height="20"
                IsIndeterminate="True" />
            <TextBlock
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Foreground="#9ca3af"
                Text="{x:Static res:Strings.Fixes_Loading}" />
        </StackPanel>

        <!--  Empty  -->
        <TextBlock
            Grid.Row="3"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Foreground="#9ca3af"
            Text="{Binding EmptyMessage}"
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

        <!--  Game grid  -->
        <vwp:VirtualizingItemsControl
            x:Name="GameScroller"
            Grid.Row="3"
            Margin="0,14,0,0"
            ItemsSource="{Binding Items}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            VirtualizingPanel.CacheLengthUnit="Page"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Standard"
            Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}">
            <vwp:VirtualizingItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel
                        Orientation="Horizontal"
                        SpacingMode="StartAndEndOnly"
                        StretchItems="False" />
                </ItemsPanelTemplate>
            </vwp:VirtualizingItemsControl.ItemsPanel>
            <vwp:VirtualizingItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Width="248"
                        Height="186"
                        Margin="0,0,12,12"
                        Background="#0DFFFFFF"
                        BorderBrush="#14FFFFFF"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Border.Tag>
                            <Binding ElementName="Root" Path="DataContext" />
                        </Border.Tag>
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.CopyAppIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Common_CopyAppId}"
                                    Icon="{ui:SymbolIcon Copy24}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Common_ShowInFolder}"
                                    Icon="{ui:SymbolIcon FolderOpen24}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel>
                            <Border
                                Height="116"
                                Background="#11FFFFFF"
                                ClipToBounds="True"
                                CornerRadius="10,10,0,0">
                                <Image Source="{Binding Cover, Converter={StaticResource ImagePathToSource}}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Margin="12,8,12,10">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#e5e7eb"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />

                                <!--  Action Buttons: Fix | Revert | Notes (?)  -->
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Fix button  -->
                                    <ui:Button
                                        Grid.Column="0"
                                        Height="28"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Appearance="Primary"
                                        Command="{Binding FixCommand}"
                                        Content="{x:Static res:Strings.Fixes_Fix}"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Icon="{ui:SymbolIcon Wrench24}"
                                        IsEnabled="{Binding CanFix}"
                                        ToolTip="Apply online multiplayer fix" />

                                    <!--  Revert button  -->
                                    <ui:Button
                                        Grid.Column="2"
                                        Height="28"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Appearance="Secondary"
                                        Command="{Binding RevertCommand}"
                                        Content="{x:Static res:Strings.Fixes_Revert}"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Icon="{ui:SymbolIcon ArrowClockwise24}"
                                        IsEnabled="{Binding CanRevert}"
                                        ToolTip="Revert applied fix files to original" />

                                    <!--  Notes (?) button  -->
                                    <ui:Button
                                        Grid.Column="4"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        Appearance="Secondary"
                                        Command="{Binding ShowNotesCommand}"
                                        FontSize="12"
                                        ToolTip="View setup notes (Примечания)">
                                        <Grid>
                                            <ui:SymbolIcon
                                                FontSize="14"
                                                Foreground="#9ca3af"
                                                Symbol="QuestionCircle24"
                                                Visibility="{Binding IsLoadingNotes, Converter={StaticResource InverseBoolToVis}, FallbackValue=Visible}" />
                                            <ui:ProgressRing
                                                Width="14"
                                                Height="14"
                                                IsIndeterminate="True"
                                                Visibility="{Binding IsLoadingNotes, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                                        </Grid>
                                    </ui:Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </vwp:VirtualizingItemsControl.ItemTemplate>
        </vwp:VirtualizingItemsControl>

        <!--
            Pager bar: page numbers centered across the full width, with sort dropdown on the left
            and results-per-page on the right. Shown once game cards are present.
        -->
        <Grid
            Grid.Row="4"
            Margin="0,12,0,2"
            Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}">

            <!--  Left: sort dropdown (A to Z / Z to A)  -->
            <StackPanel
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    Foreground="#9ca3af"
                    Text="{x:Static res:Strings.Manage_Filter_SortBy}" />
                <ComboBox
                    MinWidth="90"
                    ItemTemplate="{StaticResource FilterOptionTemplate}"
                    ItemsSource="{Binding SortOptions}"
                    SelectedItem="{Binding SelectedSort}" />
            </StackPanel>

            <!--  Centered group: ‹ prev | page numbers (fixed-width zone) | › next.  -->
            <Grid HorizontalAlignment="Center" Visibility="{Binding ShowPager, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button
                    Grid.Column="0"
                    Margin="2,0"
                    Padding="8,4"
                    Command="{Binding PrevPageCommand}"
                    Content="‹"
                    FontSize="14"
                    IsEnabled="{Binding CanGoPrev}" />
                <ItemsControl
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    ItemsSource="{Binding PageNumbers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!--  Ellipsis gap (sentinel 0): non-clickable "…"  -->
                                <TextBlock
                                    Margin="6,0"
                                    VerticalAlignment="Center"
                                    Foreground="#6b7280"
                                    Text="…">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!--  Page-number button  -->
                                <ui:Button
                                    Margin="2,0"
                                    Padding="8,4"
                                    Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding}"
                                    FontSize="13">
                                    <ui:Button.Style>
                                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                            <Style.Triggers>
                                                <!--  Hide the button for the ellipsis sentinel (0)  -->
                                                <DataTrigger Binding="{Binding}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <!--  Highlight the active page  -->
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource EqualityMulti}">
                                                            <Binding />
                                                            <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Appearance" Value="Primary" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button
                    Grid.Column="2"
                    Margin="2,0"
                    Padding="8,4"
                    Command="{Binding NextPageCommand}"
                    Content="›"
                    FontSize="14"
                    IsEnabled="{Binding CanGoNext}" />
            </Grid>

            <!--  Right: results-per-page (overlaid at the right edge, doesn't shift the centered pager)  -->
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    Foreground="#9ca3af"
                    Text="{x:Static res:Strings.Manage_ResultsPerPage}" />
                <ComboBox
                    MinWidth="72"
                    ItemTemplate="{StaticResource FilterOptionTemplate}"
                    ItemsSource="{Binding PageSizeOptions}"
                    SelectedItem="{Binding SelectedPageSize}" />
            </StackPanel>
        </Grid>


    </Grid>
</UserControl>
