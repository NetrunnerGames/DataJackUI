<UserControl
    x:Class="DataJackUIGui.Views.ToastPresenter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:DataJackUIGui.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d"
    IsHitTestVisible="True">

    <ItemsControl ItemsSource="{Binding Toasts, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
                <Setter Property="Opacity" Value="0" />
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="16" />
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    To="1"
                                    Duration="0:0:0.2" />
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    To="0"
                                    Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Style.Triggers>
            </Style>
        </ItemsControl.ItemContainerStyle>

        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type models:ToastItem}">
                <!-- WinUI 3 / Windows 11 Fluent Acrylic Floating Toast Card -->
                <Border
                    x:Name="ToastCard"
                    Margin="0,0,0,12"
                    MinWidth="320"
                    MaxWidth="390"
                    Background="#D4141622"
                    BorderThickness="1"
                    CornerRadius="8"
                    MouseEnter="OnToastMouseEnter"
                    MouseLeave="OnToastMouseLeave">
                    <!-- WinUI 3 Elevation Stroke: top light specular rim fading to subtle bottom stroke -->
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.0" Color="#2EFFFFFF" />
                            <GradientStop Offset="0.3" Color="#1EFFFFFF" />
                            <GradientStop Offset="1.0" Color="#0DFFFFFF" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>

                    <!-- WinUI 3 Elevation Drop Shadow -->
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="28"
                            Color="#000000"
                            Direction="270"
                            Opacity="0.45"
                            ShadowDepth="6" />
                    </Border.Effect>

                    <Grid>
                        <!-- WinUI 3 Top glass reflection highlight -->
                        <Border
                            Height="1"
                            VerticalAlignment="Top"
                            Background="#1CFFFFFF"
                            CornerRadius="8,8,0,0"
                            IsHitTestVisible="False" />

                        <Grid Margin="16,12,14,14">
                            <Grid.RowDefinitions>
                                <!-- Row 0: App header banner (app icon + "DataJackUI" title + dismiss button) -->
                                <RowDefinition Height="Auto" />
                                <!-- Row 1: Notification body (fluent icon + title + message + action) -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- App Branding -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        Source="pack://application:,,,/icon.ico"
                                        RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        FontWeight="Normal"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="DataJackUI" />
                                </StackPanel>

                                <!-- Dismiss Close Button -->
                                <Button
                                    Grid.Column="2"
                                    Width="24"
                                    Height="24"
                                    Margin="0,-3,-3,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding DismissCommand}"
                                    Cursor="Hand"
                                    ToolTip="Close">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="CloseBd"
                                                Background="Transparent"
                                                CornerRadius="4">
                                                <ui:SymbolIcon
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Symbol="Dismiss24" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CloseBd" Property="Background" Value="#1CFFFFFF" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="CloseBd" Property="Background" Value="#2DFFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Body Content -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Fluent Status Icon (clean, unbadged WinUI 3 style) -->
                                <ui:SymbolIcon
                                    Grid.Column="0"
                                    Margin="0,2,12,0"
                                    VerticalAlignment="Top"
                                    FontSize="18"
                                    Foreground="{Binding AccentBrush}"
                                    Symbol="{Binding Icon}" />

                                <!-- Text Content & Actions -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="13.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Message}"
                                        TextWrapping="Wrap" />

                                    <!-- Action button if present -->
                                    <ui:Button
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Appearance="Primary"
                                        Command="{Binding ActionCommand}"
                                        Content="{Binding ActionLabel}"
                                        CornerRadius="4"
                                        Padding="14,5"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
