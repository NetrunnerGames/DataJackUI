<Application
    x:Class="DataJackUIGui.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:DataJackUIGui"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Netrunner Cyan Ambient Glass Accent Palette (#06b6d4) -->
            <Color x:Key="SystemAccentColor">#06b6d4</Color>
            <Color x:Key="SystemAccentColorPrimary">#06b6d4</Color>
            <Color x:Key="SystemAccentColorLight1">#22d3ee</Color>
            <Color x:Key="SystemAccentColorLight2">#67e8f9</Color>
            <Color x:Key="SystemAccentColorLight3">#a5f3fc</Color>
            <Color x:Key="SystemAccentColorDark1">#0891b2</Color>
            <Color x:Key="SystemAccentColorDark2">#0e7490</Color>
            <Color x:Key="SystemAccentColorDark3">#155e75</Color>

            <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#06b6d4" />
            <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#06b6d4" />
            <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#1f06b6d4" />
            <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="#3f06b6d4" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#06b6d4" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#06b6d4" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#0891b2" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#0e7490" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#22d3ee" />

            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <local:StatusToBrushConverter x:Key="StatusToBrush" />
            <local:ImagePathToSourceConverter x:Key="ImagePathToSource" />
            <local:EqualityMultiConverter x:Key="EqualityMulti" />
            <local:MinHeightToVisibilityConverter x:Key="MinHeightToVis" />
            <local:FilterOptionDisplayConverter x:Key="FilterOptionDisplay" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
